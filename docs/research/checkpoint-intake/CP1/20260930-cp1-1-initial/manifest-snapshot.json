{
  "schema_version": "wolf15-development-checkpoint-donor-intake/v1",
  "status": "AGENT_PROCEDURE_CONFIGURED_NOT_APPLICATION_RUNTIME",
  "canonical_source": "README.md",
  "donor_register": "docs/research/donor-adaptation-register-20260929.md",
  "owner_login": "tjx578",
  "trigger": {
    "event": "DEVELOPMENT_AGENT_STARTS_OR_RESUMES_CHECKPOINT",
    "checkpoints": [
      "CP1",
      "CP2",
      "CP3",
      "CP4",
      "CP5",
      "CP6",
      "CP7",
      "CP8"
    ],
    "user_confirmed": true,
    "application_startup": false,
    "scheduler": false,
    "checkpoint_advancement_authorized": false
  },
  "semantics": {
    "mandatory": "Every listed donor must receive an explicit bounded study outcome before implementing its dependent CP slice; watch/reference are still mandatory to inspect, not mandatory to adopt",
    "non_dependent_work": "May proceed if unaffected; donor-dependent claims and checkpoint completion stay held for unresolved required intake",
    "new_repositories": "Discovery does not auto-add all owner repos to this manifest",
    "cp6_dynamic": "Additionally qualify every donor selected for code/skill/runtime admission, including those routed under other CPs",
    "canonical_changes": "Reconcile the union of current README/register/addenda before intake; new canonical donor missing in manifest is MANIFEST_DRIFT"
  },
  "connection": {
    "preferred": "Existing authenticated GitHub connector",
    "verify_login": true,
    "expected_login": "tjx578",
    "alternate": "Existing authorized read-only GitHub CLI/API if available; never obtain secrets from chat",
    "credentials_in_artifacts": false,
    "app_connection_implied": false
  },
  "resolution": {
    "owner_first": true,
    "exact_repository_id_first": true,
    "alias_match_is_candidate_only": true,
    "require_parent_or_source_lineage": true,
    "unbound_alias_policy": "Enumerate owner repos with pagination; inspect candidates and fork lineage, not fuzzy-name auto-selection",
    "multiple_matches": "AMBIGUOUS_REPOSITORY",
    "no_visible_match": "OWNER_FORK_NOT_RESOLVED",
    "incomplete_listing": "DISCOVERY_INCOMPLETE",
    "upstream_fallback": "NOT_AUTOMATIC; report gap, retain upstream as reference, continue unrelated tasks",
    "same_name_wrong_lineage": "IDENTITY_MISMATCH",
    "unknown_upstream": "UPSTREAM_NOT_ESTABLISHED"
  },
  "capture": {
    "refresh_head_on_each_entry": true,
    "pin_revision_for_entire_run": true,
    "cache_key": [
      "cp",
      "donor_repository_id",
      "commit_sha",
      "extraction_scope_digest",
      "extractor_profile_version"
    ],
    "same_revision_reuse": "Revalidate cached evidence hashes, scope, rights and status; reuse artifact without re-reading unchanged bytes",
    "changed_revision": "Create new snapshot and scoped delta assessment; do not overwrite old pack"
  },
  "bounded_read": {
    "initial_max_source_files_per_donor": 40,
    "initial_max_total_source_bytes_per_donor": 2097152,
    "initial_max_file_bytes": 262144,
    "max_parallel_donors": 3,
    "per_request_timeout_seconds": 30,
    "per_donor_deadline_seconds": 300,
    "budget_exhausted": "PARTIAL_COVERAGE; no completion promotion; record exclusions and next bounded slice",
    "no_bulk_clone_or_submodule_fetch": true,
    "no_install_or_execute_donor": true
  },
  "outputs": {
    "base": "docs/research/checkpoint-intake/<CP>/<run-id>/",
    "files": [
      "intake-receipt.json",
      "knowledge-pack.md",
      "skill-candidates.json",
      "adaptation-decisions.md"
    ],
    "source_reference_required": [
      "repository_id",
      "full_name",
      "commit_sha",
      "blob_sha",
      "path",
      "line_or_span"
    ],
    "candidate_kinds": [
      "EXISTING_SKILL_SOURCE",
      "RECONSTRUCTED_WORKFLOW_CANDIDATE",
      "KNOWLEDGE_ONLY"
    ],
    "empty_skills": "Record NO_REUSABLE_SKILL_FOUND with inspected scope; never fabricate an executable skill"
  },
  "skill_authority": {
    "extract_candidate": true,
    "automatic_install": false,
    "automatic_execution": false,
    "automatic_registry_activation": false,
    "qualification_cp": "CP6",
    "later_promotion_cp": "CP8",
    "activation_requires_separate_admission_and_scope": true
  },
  "failure_states": [
    "AUTH_UNAVAILABLE",
